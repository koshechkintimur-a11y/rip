# === База данных ===
# Пусто = локальный PGlite в ./.ripdata (разработка без установки Postgres)
# Пример: postgres://user:pass@host:5432/rip
DATABASE_URL=

# === Сезоны ===
# Длительность сезона в секундах для тестов. 0 = 7 дней.
# Пример: 600 = 10 минут, 1800 = 30 минут, 3600 = 1 час, 86400 = сутки
TEST_SEASON_DURATION=1800

# === Cron (Vercel Cron или внешний пингер) ===
# GET /api/cron/tick?secret=CRON_SECRET — авто-reset и смерть сезона
CRON_SECRET=change-me

# === Админ-панель ===
# Emails с доступом к /api/admin (или is_test_user=true в БД)
ADMIN_EMAILS=

# === Web Push (VAPID) ===
# Сгенерировать: node scripts/gen-vapid.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@rip.local

# === GIF ===
# Внешний провайдер GIF (Tenor API key) — опционально, пока вставка URL
GIF_PROVIDER_KEY=
